# =============================================================================
# LexiLegal AI — Environment Configuration (Template)
# =============================================================================

# --- Flask & Application Security ---
FLASK_ENV=development
FLASK_APP=app:create_app
SECRET_KEY=change_me_to_a_secure_random_string_in_production
PORT=5000

# --- Database (MySQL 8 utf8mb4) ---
MYSQL_DATABASE=lexilegal
MYSQL_USER=lexilegal
MYSQL_PASSWORD=lexilegal
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://lexilegal:lexilegal@127.0.0.1:3306/lexilegal?charset=utf8mb4

# --- Storage & Limits ---
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=10485760
RATELIMIT_DEFAULT="100 per minute"
RATELIMIT_STORAGE_URI=memory://

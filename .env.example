# =============================================================================
# LexiLegal AI — Environment Configuration
# =============================================================================

# Database (PostgreSQL 16+)
POSTGRES_DB=lexilegal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Spring Boot Backend
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/lexilegal
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
JWT_SECRET=lexilegal_dev_secret_key_needs_to_be_at_least_256_bits_long_for_hmac_sha256
JWT_EXPIRATION_HOURS=24
INTERNAL_API_KEY=lexilegal_internal_service_key_secret_2026
AI_ENGINE_URL=http://localhost:8000
STORAGE_UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
CORS_ALLOWED_ORIGINS=http://localhost:5173

# FastAPI AI Engine
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_WORKERS=1
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace_with_actual_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
LOG_LEVEL=INFO

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080/api
